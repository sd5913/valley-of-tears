config_version=5

[application]
config/name="Valley of Tears"
run/main_scene="res://main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
reflections/reflection_atlas/reflection_size=256
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.09, 0.11, 1)

[debug]
gdscript/warnings/untyped_declaration=0
